# Normalise line endings in the repository, independent of the machine that
# checks it out. Without this, every commit on Windows reports a dozen
# "LF will be replaced by CRLF" warnings and diffs churn between contributors.
* text=auto eol=lf

# PowerShell is the one format where CRLF is the conventional choice.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Never let git try to merge or convert these.
*.exe binary
*.dll binary
*.ico binary
*.png binary
*.zip binary
